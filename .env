# API URL (optional - auto-detects if not set)
# The frontend will auto-detect the API URL based on the current hostname
# Only set this if you need to override the auto-detection

# For development (default):
# VITE_API_URL=http://localhost:3001/api

# For network access (use your server's IP):
# VITE_API_URL=http://10.78.220.85:3001/api
