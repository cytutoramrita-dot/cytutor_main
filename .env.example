# ==============================================
# CyTutor Frontend Configuration
# ==============================================

# API URL (optional - auto-detects if not set)
# The frontend automatically detects the API URL based on the current hostname:
# - If accessing via localhost: uses http://localhost:3001/api
# - If accessing via network IP: uses http://<current-ip>:3001/api
#
# Only set this variable if you need to override the auto-detection

# Development (localhost):
# VITE_API_URL=http://localhost:3001/api

# Production (use your domain):
# VITE_API_URL=https://api.cytutor.com/api

# Network access (use server IP):
# VITE_API_URL=http://10.78.220.85:3001/api
