# ==============================================
# CyTutor Backend Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values

# Environment (development | production | test)
NODE_ENV=development

# ==============================================
# Server Configuration
# ==============================================
PORT=3001
# HOST is auto-configured based on NODE_ENV:
# - development: 127.0.0.1 (localhost only)
# - production: 0.0.0.0 (all interfaces)

# ==============================================
# Database Configuration
# ==============================================
DATABASE_URL=postgresql://username:password@localhost:5432/cy_tutor

# Optional: Database pool configuration
# DB_POOL_MAX=20
# DB_IDLE_TIMEOUT=30000
# DB_CONNECTION_TIMEOUT=2000

# ==============================================
# Security Configuration
# ==============================================
# REQUIRED: Generate a strong random secret for JWT
# You can generate one with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Optional: JWT expiration time (default: 7d)
# JWT_EXPIRES_IN=7d

# ==============================================
# CORS Configuration (Production Only)
# ==============================================
# Comma-separated list of allowed origins for production
# Leave empty for no CORS, or set CORS_ALLOW_ALL=true for open access
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Allow all origins in production (NOT RECOMMENDED for authenticated apps)
# CORS_ALLOW_ALL=false

# ==============================================
# Challenge Orchestration
# ==============================================
CHALLENGE_PORT_MIN=10000
CHALLENGE_PORT_MAX=20000
CHALLENGE_TIMEOUT_MINUTES=45

# Optional: Override host IP for challenge URLs
# If not set, will auto-detect network IP
# HOST_IP=10.78.220.85

# ==============================================
# Email Configuration (for OTP)
# ==============================================
# SMTP Configuration (works with any email provider)
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_SECURE=false

# Email credentials
# For Outlook/Office365, use your regular password or app password
EMAIL_USER=your-email@outlook.com
EMAIL_PASS=your-password

# ==============================================
# Rate Limiting
# ==============================================
# General API rate limit
# RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# RATE_LIMIT_MAX=100           # Max requests per window

# Auth endpoints rate limit (stricter)
# AUTH_RATE_LIMIT_MAX=5        # Max auth attempts per window

# ==============================================
# Logging
# ==============================================
# Log level: debug | info | warn | error
# LOG_LEVEL=info

# ==============================================
# Production-Only Settings
# ==============================================
# These are only used when NODE_ENV=production

# Trust proxy headers (X-Forwarded-For, etc.)
# Set to true if behind a reverse proxy like nginx
# TRUST_PROXY=true

# Enable CSRF protection (recommended for production)
# ENABLE_CSRF=true
