# ==============================================
# CyTutor Backend - Production Configuration
# ==============================================
# This is an example production configuration
# Copy to .env and customize for your deployment

# Environment
NODE_ENV=production

# Server Configuration
PORT=3001
# Server will bind to 0.0.0.0 in production (all interfaces)

# Database Configuration
DATABASE_URL=postgresql://prod_user:strong_password@db_host:5432/cy_tutor_prod

# Database Pool (optional tuning)
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Security - JWT
# CRITICAL: Use a strong, unique secret in production
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION
JWT_EXPIRES_IN=7d

# CORS Configuration
# Specify your frontend domain(s)
CORS_ORIGINS=https://cytutor.example.com,https://www.cytutor.example.com

# Only set to true if you need to allow all origins (NOT RECOMMENDED)
# CORS_ALLOW_ALL=false

# Challenge Orchestration
CHALLENGE_PORT_MIN=10000
CHALLENGE_PORT_MAX=20000
CHALLENGE_TIMEOUT_MINUTES=45

# Network IP for challenge URLs
# Set this to your server's public/network IP
HOST_IP=your.server.ip.address

# Email Configuration
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASS=your-production-password

# Rate Limiting (optional - adjust based on your needs)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100           # Max requests per window
AUTH_RATE_LIMIT_MAX=5        # Max auth attempts per window

# Logging
LOG_LEVEL=info  # Use 'info' or 'warn' in production

# Production Security Settings
# These are automatically enabled in production, but can be overridden
# TRUST_PROXY=true
# ENABLE_CSRF=true
